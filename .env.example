# Copy to .env and edit. Never commit the real file.

# How your devices reach the server (no trailing slash). Must match what you
# enter in F-Droid: changing it later means re-adding the repo.
PUBLIC_URL=https://fdroid.example.com

# Shared secret for uploading/deleting APKs. Generate with: openssl rand -hex 24
UPLOAD_TOKEN=

# Optional
# REPO_NAME=My F-Droid Repo
# PORT=8080
# PUID=1000   # `id -u`
# PGID=1000   # `id -g`
# FDROID_IMAGE=ghcr.io/OWNER/fdroid-selfhost:latest   # use a released image instead of building
